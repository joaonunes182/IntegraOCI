# ============================================================
# IntegraOCI — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ============================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-troque-em-producao

# ---------------------------------------------------------------------------
# Hosts / origens permitidas
# ---------------------------------------------------------------------------
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Banco de dados principal (Django ORM)
# SQLite para desenvolvimento, PostgreSQL recomendado em produção
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=integra_oci
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# Cache Redis (obrigatório para rate-limiting e limpeza automática)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
TOKEN_EXPIRATION_TIME=86400
JWT_ACCESS_MINUTES=60

# ---------------------------------------------------------------------------
# Banco MySQL externo — SIGTAP
# Opcional: usado para buscar nomes de procedimentos pelo código.
# Deixe em branco para desabilitar esta funcionalidade.
# ---------------------------------------------------------------------------
MYSQL_DATA_HOST=
MYSQL_DATA_USER=
MYSQL_DATA_PASSWORD=
MYSQL_DATA_DB=
MYSQL_DATA_PORT=3306

# ---------------------------------------------------------------------------
# Artefatos BPA/APAC (retenção em dias; 0 = desabilitar limpeza automática)
# ---------------------------------------------------------------------------
BPA_APAC_ARTIFACT_RETENTION_DAYS=90
BPA_APAC_AUTO_CLEANUP=True

# ---------------------------------------------------------------------------
# Upload
# ---------------------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=209715200
DATA_UPLOAD_MAX_NUMBER_FILES=50

# ---------------------------------------------------------------------------
# Segurança (habilitar em produção)
# ---------------------------------------------------------------------------
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
